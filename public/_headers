# Cabeceras de seguridad para Cloudflare Pages.
# Cloudflare lee este archivo y las aplica; no se muestra como página.
# Ojo: no repitas un mismo encabezado en dos reglas distintas (Cloudflare las suma y se duplica).

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: microphone=(self), camera=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), display-capture=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.youtube.com https://www.gstatic.com https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; frame-src https://www.youtube.com https://www.google.com/recaptcha/ https://recaptcha.google.com/recaptcha/; connect-src 'self' https://api.datamuse.com https://content-firebaseappcheck.googleapis.com https://firebasevertexai.googleapis.com; img-src 'self'; style-src 'self' 'unsafe-inline'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

# El service worker nunca debe quedarse guardado en el navegador: así las actualizaciones llegan siempre
/sw.js
  Cache-Control: no-cache
